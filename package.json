{
  "name": "turnleaf",
  "version": "1.0.0",
  "private": true,
  "description": "Turnleaf: read any PDF as a real book, with page-curl animation and paper sound.",
  "scripts": {
    "build:www": "node scripts/build-www.js",
    "serve": "npm run build:www && node scripts/serve.js",
    "icons": "npx capacitor-assets generate --android",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:www && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "page-flip": "2.0.7",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  },
  "engines": { "node": ">=22" }
}
